# Copy to .env and fill in. .env is git-ignored: never commit it.
# Telegram bot for the GAME (create a NEW bot with @BotFather; never reuse the trading bot's token).
BTB_TELEGRAM_TOKEN=
# Group chat the game runs in (find it with: python -m btb whereami)
BTB_CHAT_ID=
# OpenAI-compatible endpoint of your model, e.g. https://your-host/v1
GLM_BASE_URL=
GLM_MODEL=gx10-current
GLM_API_KEY=
# Moomoo OpenD (quotes only; the game never opens a trade context)
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
# Names shown in the group (optional)
BTB_GAME_NAME=Huat or Not?
BTB_BOT_NAME=🤖 Ah Huat
